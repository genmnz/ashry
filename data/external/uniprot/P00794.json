 "comments": [
  {
   "texts": [
    {
     "value": "Chymosin is synthesized in the mucosa of the abomasum (fourth stomach) of young (unweaned) ruminants. The enzyme hydrolyzes casein to paracasein"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "commentType": "CATALYTIC ACTIVITY",
   "reaction": {
    "name": "Broad specificity similar to that of pepsin A. Clots milk by cleavage of a single 104-Ser-Phe-|-Met-Ala-107 bond in kappa-chain of casein.",
    "ecNumber": "3.4.23.4"
   }
  },
  {
   "texts": [
    {
     "value": "Monomer"
    }
   ],
   "commentType": "SUBUNIT"
  },
  {
   "texts": [
    {
     "value": "Forms A and B are probably allelic variants. Form B is the predominant form and differs only in one position"
    }
   ],
   "commentType": "POLYMORPHISM"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Belongs to the peptidase A1 family"
    }
   ],
   "commentType": "SIMILARITY"
  }
 ],
