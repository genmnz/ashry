 "comments": [
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "16243453"
      },
      {
       "evidenceCode": "ECO:0000305"
      }
     ],
     "value": "Aerial growth, conidiation, and dispersal of filamentous fungi in the environment depend on their ability to secrete small amphipathic proteins called hydrophobins (HPBs) with low sequence identity. Class I can self-assemble into an outermost layer of rodlet bundles on aerial cell surfaces, conferring cellular hydrophobicity that supports fungal growth, development and dispersal; whereas Class II form highly ordered films at water-air interfaces through intermolecular interactions but contribute nothing to the rodlet structure (Probable). Hbf1 is a class II hydrophobin that has a role in hyphal development and is in particular required for the formation of aerial hyphae (PubMed:16243453)"
    }
   ],
   "commentType": "FUNCTION"
  },
  {
   "texts": [
    {
     "evidences": [
      {
       "evidenceCode": "ECO:0000269",
       "source": "PubMed",
       "id": "16882996"
      }
     ],
     "value": "Homotetramer (PubMed:16882996). Further self-assembles to form highly ordered films at water-air interfaces through intermolecular interactions (PubMed:16882996)"
    }
   ],
   "commentType": "SUBUNIT"
  },
