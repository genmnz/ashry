      "geneName": "LALBA",
      "intActId": "EBI-7080486"
     },
     "numberOfExperiments": 3,
     "organismDiffer": false
    }
   ]
  },
  {
   "commentType": "SUBCELLULAR LOCATION",
   "subcellularLocations": [
    {
     "location": {
      "value": "Secreted",
      "id": "SL-0243"
     }
    }
   ]
  },
  {
   "texts": [
    {
     "value": "Mammary gland specific. Secreted in milk"
    }
   ],
   "commentType": "TISSUE SPECIFICITY"
  },
  {
   "texts": [
    {
     "value": "Causes an allergic reaction in human. Is one of the causes of cow's milk allergy"
    }
   ],
   "commentType": "ALLERGEN"
  },
